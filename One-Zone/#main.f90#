PROGRAM main

  use global
  use controls
  use diste, only: diste_run
  use distp, only: distp_run
  use radbr, only: radbr_run
  use radic, only: radic_run
  use radsyn, only: radsyn_run
  use radpp, only: radpp_run
  use opac_ff, only: opac_ff_run
  use abssyn, only: abssyn_run

  implicit none    
  integer :: i_IC
  real(dp) :: Ef_IC(mE_f)

!  interface
!     subroutine radic_run(T,Kappa,LIC_vec)!,n_vec)
!       use iso_fortran_env, only: dp => real64
!       implicit none
!       integer, intent(in) :: n_vec
!       real(dp), intent(in) :: T,Kappa
!       real(dp), intent(out) :: LIC_vec(:) !(n_vec)
!     end subroutine radic_run
!  end interface
  
  write(*,*) ''
  write(*,*) '============================'
  write(*,*) ' START'
  write(*,*) '============================'
  write(*,*) ''


88    format(A11,X,Es10.2)
!  write(*,88) 'R_st[Ro]=',R_st/R_sun
!  write(*,88) 'L_st[Lo]=',L_st/L_sun
  write(*,88) 'R0[pc]=',R0/pc
  write(*,88) 'R0_pr[s]=',(R0/AU)/(distance/pc)*abs(cos(incli))
  write(*,88) 'B[G]=',B
  write(*,88) 'n_a[cm-3]=',n_a
  write(*,88) 'T_IR[K]=',T_IR
!  write(*,88) 'T_IR[K]=',16.4* ( (L_st/(4.*pi*R0**2.))/0.0217 )**(1./6.) ! Kobulnicky 2016
!  write(*,88) 'T_IR[K]=',T_st*(R_st/(2*R0))**(1./3.) ! Meyer 2016
  write(*,88) 'T_IR[K]=',T_st*(R_st/(2*R0))**(1./3.) ! Meyer 2016

  write(*,*) ''

  IF (electrons.eqv.yes) then
     write(*,*) 'ELECTRONS:'
     
     if (diste_calc.eqv.yes) then
        write(*,*) 'Calculate the non-thermal electron distribution in the SW'
        call diste_run  
     endif
     
     write(*,*) ''

     if (radsyn_calc.eqv.yes) then       
        write(*,*) 'Calculate the (unabsorbed) sync. emission in the SW'
        call radsyn_run
     endif
     
     write(*,*) ''
     
     if (radbr_calc.eqv.yes) then
        write(*,*) 'Calculate the (unabsorbed) rel. brem. emission in the SW'
        call radbr_run
     endif
     
     write(*,*) ''
     
     if (radic_calc.eqv.yes) then

        write(*,*) 'Calculate the (unabsorbed) IC-dust emission in the SW'
        call radic_run(T_IR,Kappa_IR,Ef_IC,Lic)
        open(17,file='radic_IR.dat')
        do i_IC = 1,mE_f
           write(17,*) Ef_IC(i_IC)/eV,Ef_IC(i_IC)*Lic(i_IC)
        enddo
        close(17)
        
        write(*,*) 'Calculate the (unabsorbed) IC-star emission in the SW'
        call radic_run(T_st,Kappa_st,Ef_IC,Lic)
        open(18,file='radic_st.dat')
        do i_IC = 1,mE_f
           write(18,*) Ef_IC(i_IC)/eV,Ef_IC(i_IC)*Lic(i_IC)
        enddo
        close(18)

     endif
     
     write(*,*) ''
     
     if (opac_ff_calc.eqv.yes) then
        write(*,*) 'Calculate the f-f abs. and emi. coefficients in the stellar wind'
        call opac_ff_run
     end if    
     
     write(*,*) ''    

     if (abssyn_calc.eqv..true.) then
        write(*,*) 'Calculate the free-free synchrotron absorption'
        call abssyn_run
     endif
     
     write(*,*) ''

  ENDIF

  !--------------------------------

  IF (protons.eqv.yes) then
     write(*,*) 'PROTONS:'
     
     if (distp_calc.eqv.yes) then
        write(*,*) 'Calculate the non-thermal proton distribution in the SW'
        call distp_run 
        write(*,*) '' 
     endif
     

     if (radpp_calc.eqv.yes) then
        write(*,*) 'Calculate the p-p emission in the SW'
        call radpp_run 
        write(*,*) '' 
     endif
  ENDIF

  !================================================================


  write(*,*) '============================'
  write(*,*) ' END'
  write(*,*) '============================'
  
  
END PROGRAM main

   
    
