set view map

set contour base
set isosamples 250
set cntrparam bspline
#set cntrparam level incremental 1.,20.,400.
set cntrparam levels discrete 10,20,50,100,200,300,400
unset surface
set table 'cont.dat'
splot './SW_conv_1Gabs.dat' u 1:2:3
unset table

reset
set encoding iso_8859_1
set title ''
set xlabel 'x'
set ylabel 'y'

set cblabel 'Flux [mJy beam^{-1}]'
set yrange [-10.:10.]
set xrange [-10.:10.]
#set cbrange [0.1:100]

set pm3d interpolate 0,0
set view map
set palette gray negative
unset key
set size ratio 1./1.

coc = 2.
set label 1 "" at 0.0,0.0 front point pointtype 7 lc 3 lw 2 ps 1

set object 5 ellipse center graph 0.91,0.91 size 1.*coc,1.*coc angle 0. fc rgb "grey" fs solid 1.0 border -1 front

splot './SW_conv_1Gabs.dat' u ($1):($2):($3) w pm3d, 'cont.dat' w l lt -1 lw 1.5
set terminal postscript colour enhanced dl 3.5 lw 2. "Helvetica" 21
set output 'convmap_1G.ps'
replot
!./fixbb convmap_1G.ps
