PROGRAM main

  use global
  use controles
  use BB, only: BB_run
  use WCR_thermal, only: WCR_thermal_run
  use CD, only: CD_run
  use CD_rot, only: CD_rot_run
  use CD_termo, only: CD_termo_run
  use CD_dist, only: CD_dist1_run, CD_dist2_run
  use CD_radsyn, only: CD_radsyn1_run, CD_radsyn2_run
  use opacidad_ff, only: opacidad_ff_run
  use opacidad_gg, only: opacidad_gg_run
  use CD_radic, only: CD_radic1_run, CD_radic2_run
  use CD_radbr, only: CD_radbr1_run, CD_radbr2_run
  use CD_abssyn, only: CD_abssyn_run
  use CD_distp, only: CD_distp1_run, CD_distp2_run
  use CD_radpp, only: CD_radpp1_run, CD_radpp2_run
  use WCR_conv, only: WCR_conv2G_run, WCR_conv8G_run
  use chi_test, only: chi_test_run

  implicit none
  integer :: i_phi, i_E
  real(dp) :: phi,LIC_unabs,LIC_abs,Lsy_unabs,Lsy_abs,Lbr_unabs,Lbr_abs,Lpp_abs
  real(dp) :: Lpp_unabs
  real(dp) :: E_IC(mE_tot),LIC_WCR_unabs(mE_tot),LIC_WCR_abs(mE_tot)
  real(dp) :: E_sy(mnu),Lsy_WCR_unabs(mnu),Lsy_WCR_abs(mnu)
  real(dp) :: E_br(mE_f),Lbr_WCR_unabs(mE_f),Lbr_WCR_abs(mE_f)
  real(dp) :: E_pp(mE_f),Lpp_WCR_unabs(mE_f),Lpp_WCR_abs(mE_f)
  real(dp) :: u_proj,v_proj,emi,emi_abs
!  character(len=300) :: dir_data 
!  character(len=100) :: prefix_dir_data, cmd, str_test

  LIC_WCR_abs = 0.d0
  LIC_WCR_unabs = 0.d0 
  Lbr_WCR_abs = 0.d0
  Lbr_WCR_unabs = 0.d0
  Lsy_WCR_abs = 0.d0
  Lsy_WCR_unabs = 0.d0
  Lpp_WCR_abs = 0.d0
  Lpp_WCR_unabs = 0.d0

  if (CD_.eqv.yes) then
     write(*,*) 'Calculo las coords de la CD'
     call CD_run        
  endif

  if (termo.eqv.yes) then
     write(*,*) 'Calculo las variables termodinámicas en la CD'
     call CD_termo_run
  endif
  
  if (absff.eqv.yes) then
     write(*,*) 'Calculo los coeficientes de absorción f-f y emisión f-f del viento estelar en radio e IR'
     call opacidad_ff_run
  endif
  
  if (absgg.eqv.yes) then
     write(*,*) 'Calculo los coeficientes de absorción gamma-gamma'
     call opacidad_gg_run
  endif

  if (BBrad.eqv.yes) then
     write(*,*) 'Calculo la emisión térmica de las estrellas'
     call BB_run
  endif

  if (Xrad.eqv.yes) then
     write(*,*) 'Calculo la emisión térmica de la WCR'
     call WCR_thermal_run
  endif

  !================================================================

  !////////////////////////////////////////////////////////////////
  !                                                               /
  !                  Electrones                                   /
  !                                                               /
  !////////////////////////////////////////////////////////////////

  IF (electrons.eqv.yes) then
     write(*,*) 'ELECTRONES:'
     
     if (maps.eqv.yes) then      
        open(88,file='WCR_radiomap_2GHz.dat')
        open(89,file='WCR_radiomap_8GHz.dat')
     endif
     
     if (dist1.eqv.yes) then
        write(*,*) 'Calculo la distribución de electrones NT en el S1'
        call CD_dist1_run  
     endif
     if (dist2.eqv.yes) then
        write(*,*) 'Calculo la distribución de electrones NT en el S2'
        call CD_dist2_run 
     endif
     
     if (radsyn1.eqv.yes) then
        write(*,*) 'Calculo la emisión sincrotrón (sin abs) en el S1'
        call CD_radsyn1_run
     endif
     if (radsyn2.eqv.yes) then
        write(*,*) 'Calculo la emisión sincrotrón (sin abs) en el S2'
        call CD_radsyn2_run
     endif

     ! Hay cosas que dependen de la posición sobre la WCR, así que hago distintos
     ! emisores línea para distintos ángulos. La radiación IC y la absorción g-g
     ! por un lado, y la absorción f-f por el otro.
     
     phi = 0.d0
     DO i_phi = 1,mphi
        write(*,*) 'i(phi)=',i_phi,'/',mphi
        !     write(*,*) 'phi(deg)=', phi*180_dp/pi
        
        open (15,file='phi.dat')
        write(15,*) phi
        close(15)
        
        if (rotar.eqv..true.) then
           write(*,*) 'Roto las coords de la CD'
           call CD_rot_run        
        endif
        
        if (radic1.eqv..true.) then
           write(*,*) 'Calculo la emisión IC (con abs) en el S1'
           call CD_radic1_run
           open (40,file='radic1.dat')
           do i_E = 1,mE_tot
              read(40,*) E_IC(i_E),LIC_unabs,LIC_abs
              LIC_WCR_unabs(i_E) = LIC_WCR_unabs(i_E) + LIC_unabs
              LIC_WCR_abs(i_E) = LIC_WCR_abs(i_E) + LIC_abs
           enddo
           close(40)
        endif
        
        if (radic2.eqv..true.) then
           write(*,*) 'Calculo la emisión IC (con abs) en el S2'
           call CD_radic2_run
           open (41,file='radic2.dat')
           do i_E = 1,mE_tot
              read(41,*) E_IC(i_E),LIC_unabs,LIC_abs
              LIC_WCR_unabs(i_E) = LIC_WCR_unabs(i_E) + LIC_unabs
              LIC_WCR_abs(i_E) = LIC_WCR_abs(i_E) + LIC_abs
           enddo
           close(41)
        endif

        if (radbr1.eqv..true.) then
           write(*,*) 'Calculo la emisión Brem (con abs) en el S1'
           call CD_radbr1_run
           open (42,file='radbr1.dat')
           do i_E = 1,mE_f
              read(42,*) E_br(i_E),Lbr_unabs,Lbr_abs
              Lbr_WCR_unabs(i_E) = Lbr_WCR_unabs(i_E) + Lbr_unabs
              Lbr_WCR_abs(i_E) = Lbr_WCR_abs(i_E) + Lbr_abs
           enddo
           close(42)
        endif

        if (radbr2.eqv..true.) then
           write(*,*) 'Calculo la emisión Brem (con abs) en el S2'
           call CD_radbr2_run
           open (43,file='radbr2.dat')
           do i_E = 1,mE_f
              read(43,*) E_br(i_E),Lbr_unabs,Lbr_abs
              Lbr_WCR_unabs(i_E) = Lbr_WCR_unabs(i_E) + Lbr_unabs
              Lbr_WCR_abs(i_E) = Lbr_WCR_abs(i_E) + Lbr_abs
           enddo
           close(43)
        endif
        
        if (abssyn.eqv..true.) then
           write(*,*) 'Calculo la absorción neta de la radiación sincrotrón'
           call CD_abssyn_run
           open (45,file='radsynabs.dat')
           do i_E = 1,mnu
              read(45,*) E_sy(i_E),Lsy_unabs,Lsy_abs
              Lsy_WCR_unabs(i_E) = Lsy_WCR_unabs(i_E) + Lsy_unabs
              Lsy_WCR_abs(i_E) = Lsy_WCR_abs(i_E) + Lsy_abs
           enddo
           close(45)
        endif
        
        if (mapas.eqv.yes) then           
           write(*,*) 'Guardo los mapas sinteticos'
           open(55,file='CD_radiomap_2GHz.dat')
           open(56,file='CD_radiomap_8GHz.dat')
           do i=1,ml
              read(55,*) u_proj,v_proj,emi,emi_abs
              write(88,*) u_proj,v_proj,emi,emi_abs
              if (i_phi.ne.1 .and. i_phi.ne.mphi) then
                 write(88,*) u_proj,-v_proj,emi,emi_abs ! El simétrico
              endif
              read(56,*) u_proj,v_proj,emi,emi_abs
              write(89,*) u_proj,v_proj,emi,emi_abs  
              if (i_phi.ne.1 .and. i_phi.ne.mphi) then
                 write(89,*) u_proj,-v_proj,emi,emi_abs ! El simétrico
              endif
           enddo
           close(55)
           close(56)
        endif
        phi = phi + delta_phi
        
     ENDDO
          
     close(88)
     close(89)
     
     
     ! Ahora grabo todo
     if (escribir_e.eqv.yes) then
        if ((radic1.eqv.yes).and.(radic2.eqv.yes)) then
           open (50,file='radic_WCR.dat')
           do i=1,mE_tot
              ! Multiplico en un factor 2 los flujos porque sólo barrí la mitad 
              ! de los emisores línea aprovechando la simetría axial
              write(50,*) E_IC(i),2.d0*LIC_WCR_unabs(i),2.d0*LIC_WCR_abs(i)
           enddo
           close(50)
        endif

        if (abssyn.eqv.yes) then
           open (51,file='radsyn_WCR.dat')
           do i=1,mnu
              ! Multiplico en un factor 2 los flujos porque sólo barrí la mitad
              ! de los emisores línea aprovechando la simetría axial
              write(51,*) E_sy(i),2.d0*Lsy_WCR_unabs(i),2.d0*Lsy_WCR_abs(i)
           enddo
           close(51)
        endif

        if ((radbr1.eqv.yes).and.(radbr2.eqv.yes)) then
           open (52,file='radbr_WCR.dat')
           do i=1,mE_f
              ! Multiplico en un factor 2 los flujos porque sólo barrí la mitad
              ! de los emisores línea aprovechando la simetría axial
              write(52,*) E_br(i),2.d0*Lbr_WCR_unabs(i),2.d0*Lbr_WCR_abs(i)
           enddo
           close(52)
        endif
     endif

  ENDIF


  !================================================================
  

  !////////////////////////////////////////////////////////////////
  !                                                               /
  !                    Protones                                   /
  !                                                               /
  !////////////////////////////////////////////////////////////////

  IF (protons.eqv.yes) then
     write(*,*) 'PROTONES:'
     
     if (dist1p.eqv.yes) then
        write(*,*) 'Calculo la distribución de protones NT en el S1'
        call CD_distp1_run  
     endif
     if (dist2p.eqv.yes) then
        write(*,*) 'Calculo la distribución de protones NT en el S2'
        call CD_distp2_run 
     endif

     ! Hay cosas que dependen de la posición sobre la WCR, así que hago distintos
     ! emisores línea para distintos ángulos (por la abs g-g)

     phi = 0.d0
     DO i_phi = 1,mphi
        write(*,*) 'i(phi)=',i_phi,'/',mphi
        !     write(*,*) 'phi(deg)=', phi*180_dp/pi
        
        open (15,file='phi.dat')
        write(15,*) phi
        close(15)
        
        if (rotar.eqv.yes) then
           write(*,*) 'Roto las coords de la CD'
           call CD_rot_run        
        endif
        
        if (radpp1.eqv.yes) then
           write(*,*) 'Calculo la emisión p-p de protones NT en el S1'
           call CD_radpp1_run  
           open (50,file='radpp1.dat')
           do i_E = 1,mE_f
              read(50,*) E_pp(i_E),Lpp_unabs,Lpp_abs
              Lpp_WCR_unabs(i_E) = Lpp_WCR_unabs(i_E) + Lpp_unabs
              Lpp_WCR_abs(i_E) = Lpp_WCR_abs(i_E) + Lpp_abs
           enddo
           close(50)           
        endif

       if (radpp2.eqv.yes) then
           write(*,*) 'Calculo la emisión p-p de protones NT en el S2'
           call CD_radpp2_run  
           open (51,file='radpp2.dat')
           do i_E = 1,mE_f
              read(51,*) E_pp(i_E),Lpp_unabs,Lpp_abs
              Lpp_WCR_unabs(i_E) = Lpp_WCR_unabs(i_E) + Lpp_unabs
              Lpp_WCR_abs(i_E) = Lpp_WCR_abs(i_E) + Lpp_abs
           enddo
           close(51)           
        endif

     ENDDO

     ! Ahora grabo todo
     if (escribir_p.eqv.yes) then
        open (60,file='radpp_WCR.dat')
        do i=1,mE_f
           ! Multiplico en un factor 2 los flujos porque sólo barrí la mitad de los 
           ! emisores línea aprovechando la simetría axial
           write(60,*) E_pp(i),2.d0*Lpp_WCR_unabs(i),2.d0*Lpp_WCR_abs(i)
        enddo
        close(60)
     endif

        
  ENDIF



  !================================================================



  if (convolucionar.eqv.yes) then
     write(*,*) 'Convoluciono el mapa con la rta del instrumento'
     call WCR_conv2G_run
     call WCR_conv8G_run  
  endif

  if (test.eqv.yes) then
     write(*,*) 'Corremos un test de chi cuadrado en radio'
     call chi_test_run
  endif

  !=================================================================

!  prefix_dir_data = '/home/santiagodp/Trabajos/Spectrum of CWB/Modelo/Codigo modular/Estrella1 adelante'

!  dir_data = trim(prefix_dir_data)// "/" &
!       // trim('incli')
  
!  cmd = 'mkdir -p ' // trim(dir_data)
!  call system(cmd)

!  cmd = 'cp input.log ' // trim(dir_data) // '/'
!  call system(cmd)

!  call SED_run

  write(*,*) 'Terminado todo'
  
END PROGRAM main

   
    
