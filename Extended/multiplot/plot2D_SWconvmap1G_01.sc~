set view map

set contour base
set isosamples 250
set cntrparam bspline
#set cntrparam level incremental 0.1,0.1,5
set cntrparam level incremental 0.05,0.05,5
unset surface
set table 'cont_01.dat'
splot './SW_conv_1Gabs_01.dat' u ($1/60.):(-$2/60.):($3)
unset table

reset
set encoding iso_8859_1
set title 'Synthetic map at 1.4 GHz'
set title ''
set xlabel 'x [arcmin]'
set ylabel 'y [arcmin]'

set cblabel 'Flux [mJy beam^{-1}]'
set yrange [-3.:5.]
set xrange [-6.:6.]
#set cbrange [0.1:]

set pm3d interpolate 0,0
set view map
set palette gray negative
unset key
set size ratio 0.8/1.2
set xtics 2; set mxtics 2; set xlabel offset 0,0.5
set ytics 2; set mytics 2
set cbtics 1; set mcbtics 2

set arrow 4 from -0.01,0.1 to -0.01,1.6 head filled front linecolor rgb '#6495ED' linewidth 2.0
set label 2 "{/ZapfDingbats \110}" at -0.36,0.0 front textcolor rgb '#008B8B' font "Helvetica,28"

res = 12./60.
coc = 2.5
siz = res*coc
set object 5 ellipse center graph 0.91,0.91 size siz,siz angle 0. fc rgb "grey" fs solid 1.0 border -1 front

splot './SW_conv_1Gabs_01.dat' u ($1/60.):(-$2/60.):($3) w pm3d, 'cont_01.dat' w l lt -1 lw 1.5,\
      './R0_proj_01.dat' u ($1/60.):($2/60.):1 ps 3 pt 1

set terminal postscript colour enhanced dl 2.5 lw 2. "Helvetica" 22
set output 'convmap_1G_01.eps'
replot
!./fixbb convmap_1G_01.eps
