set encoding iso_8859_1
#set key box opaque #height 0.6 width 0.50 
set key top left samplen 3. spacing 1.01 font ",20"
set xrange [0:14]
set yrange [25:31]
set xtics 3; set mxtics 3
set ytics 1; set mytics 2
set xlabel 'log_{10} ({/Symbol e} [eV])'
set ylabel 'log_{10} ({/Symbol e} L_{/Symbol e} [erg s^{-1}])'
set xlabel offset 0.0,0.3
set ylabel offset 1.,0.0

#-----------------------------------------
#
#     PLOT
#
#----------------------------------------

plot './radic_ir_tot.dat' u (log10($1)):(log10($2)) t 'IC-dust' w l lw 2.4 dt 2 lc 1 smooth bezier,\
     './radic_st_tot_1.dat' u (log10($1)):(log10($2)) t 'IC-star(0°)' w l lw 2.4 dt 1 lc 2 smooth bezier,\
     './radic_st_tot_45.dat' u (log10($1)):(log10($2)) t 'IC-star(45°)' w l lw 2.4 dt 1 lc 6 smooth bezier,\
     './radic_st_tot_120.dat' u (log10($1)):(log10($2)) t 'IC-star(120°)' w l lw 2.4 dt 1 smooth bezier,\
     './radic_st_tot_89.dat' u (log10($1)):(log10($2)) t 'IC-star(90°)' w l lw 2.4 dt 1 lc 4 smooth bezier,\
     './radic_st_tot_135.dat' u (log10($1)):(log10($2)) t 'IC-star(135°)' w l lw 2.4 dt 1 lc 7 smooth bezier

#     './radic_st_tot_10.dat' u (log10($1)):(log10($2)) t 'IC-star(10)' w l lw 2.4 dt 1 smooth bezier,\
#     './radic_st_tot_60.dat' u (log10($1)):(log10($2)) t 'IC-star(60)' w l lw 2.4 dt 1 smooth bezier,\
#     './radic_st_tot_120.dat' u (log10($1)):(log10($2)) t 'IC-star(120°)' w l lw 2.4 dt 1 smooth bezier,\
#     './radic_st_tot_150.dat' u (log10($1)):(log10($2)) t 'IC-star(150)' w l lw 2.4 dt 1 smooth bezier,\
#     './radic_st_tot_170.dat' u (log10($1)):(log10($2)) t 'IC-star(170°)' w l lw 2.4 dt 1 smooth bezier

set terminal postscript colour solid enhanced dl 1.25 lw 2.4 "Helvetica" 22
set output 'SED_IC_generic.eps'
replot
