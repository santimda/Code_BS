set pm3d interpolate 0,0
set view map

set contour base
#set cntrparam level incremental -2.,0.25,1.0
#set cntrparam levels incremental log10(0.4),0.2,log10(3.)
#set cntrparam levels incremental 0.4,0.5,3
#set cntrparam levels discrete 0.1,0.2,0.3,0.4,0.6,0.8,0.9,1.0,1.4,1.8
set cntrparam levels incremental 0.4,0.1,1.6
unset surface
set table 'cont.dat'
#splot './WCR_conv_2Gabs.dat' u 1:2:(log10($3)) w pm3d
splot './WCR_conv_2Gabs.dat' u 1:2:3 w pm3d
unset table

reset
set encoding iso_8859_1
#set title 'Synthetic map at 2.3 GHz'
set title ''
set xlabel 'x [mas]'
set ylabel 'y [mas]'
#set cblabel 'log_{10}(Flux [mJy beam^{-1}])'
set cblabel 'Flux [mJy beam^{-1}]'
set yrange [-0.25*a:0.75*a]
set xrange [-0.75*a:0.75*a]
#set cbrange [log10(0.3):log10(3.)]
#set cbrange [0.2:3]
set cbrange [0.2:2]
set pm3d interpolate 0,0
set view map
set palette gray negative
unset key
#set size square
set size ratio 2./3.
set label 1 "" at +0.002*D,0 front point pointtype 1 lc 3 lw 2 ps 16
set label 2 "1" at 0.25*D,-a/10. font "Helvetica,23" front textcolor lt 3

set label 3 "" at -0.002*D,D front point pointtype 1 lc 1 lw 2 ps 16
set label 4 "2" at 0.25*D,1.25*D font "Helvetica,23" front textcolor lt 1

set object 5 ellipse center 1.2*D*closer,-0.6*D*closer size 15.0,11.0 angle 0. fc rgb "grey" fs solid 1.0 border -1 front

#splot './WCR_conv_2Gabs.dat' u 1:2:(log10($3)) w pm3d, 'cont.dat' w l lt -1 lw 1.5
splot './WCR_conv_2Gabs.dat' u 1:2:3 w pm3d, 'cont.dat' w l lt -1 lw 1.5
set terminal postscript colour enhanced dl 6.5 lw 1.7"Helvetica" 21
set output 'convmap_2GHz_i10_nohard_1D.ps'
replot
!./fixbb convmap_2GHz_i10_nohard_1D.ps
!epstopdf convmap_2GHz_i10_nohard_1D.ps
